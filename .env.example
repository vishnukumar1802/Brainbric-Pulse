# Postgres connection string. On Vercel, add Neon from the Storage tab and this is set for you.
# Leave empty locally to use a built-in file database in .pglite/
DATABASE_URL=

# Long random string used to sign login sessions (32+ characters).
AUTH_SECRET=

# First admin account. Created automatically the first time anyone opens the login page
# while the database has no users. Change the password after your first login.
ADMIN_NAME=Vishnukumar V
ADMIN_EMAIL=vishnukumar@brainbric.com
ADMIN_PASSWORD=

# Secret the AI agents send with every update to /api/ingest (32+ random characters).
INGEST_TOKEN=
